APP_NAME=WasteWaste ML
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

MODEL_PATH=artifacts/waste_classifier.keras
MODEL_METADATA_PATH=artifacts/model_metadata.json

MAX_UPLOAD_SIZE_MB=5

ML_SERVICE_URL=http://ml:8000
ML_SERVICE_TIMEOUT_MS=15000

# Shared secret the backend sends as X-Internal-Token (required when APP_ENV=production).
INTERNAL_TOKEN=
MAX_CONCURRENT_PREDICTIONS=4
